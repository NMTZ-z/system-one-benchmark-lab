{
  "name": "local-system-one-dsh",
  "version": "0.1.0",
  "private": true,
  "description": "Reversible Local System One Search Gate bundle for DeepSeek Harness",
  "license": "Apache-2.0",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "system-one",
    "typed-decision",
    "search-gate",
    "cordis"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NMTZ-z/system-one-benchmark-lab.git",
    "directory": "integrations/deepseek-harness/local-system-one-dsh"
  },
  "homepage": "https://github.com/NMTZ-z/system-one-benchmark-lab/tree/main/integrations/deepseek-harness/local-system-one-dsh",
  "bugs": {
    "url": "https://github.com/NMTZ-z/system-one-benchmark-lab/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "cordis.patch.yml",
    "example"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-agent": "0.1.7-rc.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-agent": {
      "optional": true
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "22.20.0",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
